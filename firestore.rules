rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers de Seguridad ──────────────────────────────────────────────
    function esAutenticado() {
      return request.auth != null;
    }

    function getDatosUsuario() {
      return get(/databases/$(database)/documents/v2_users/$(request.auth.uid)).data;
    }

    function esAdmin() {
      return esAutenticado() && getDatosUsuario().rol in ['ADMIN', 'DUEÑO'];
    }

    function esVendedor() {
      return esAutenticado() && getDatosUsuario().rol in ['VENDEDOR', 'ADMIN', 'DUEÑO'];
    }

    function keysHaveAny(requiredA, requiredB) {
      return request.resource.data.keys().hasAll(requiredA) || request.resource.data.keys().hasAll(requiredB);
    }

    function stockFieldsOnly() {
      return ['cantidadEnBase', 'cantidadDisponible', 'currentQty', 'ultimaActualizacion', 'lastUpdated'];
    }

    function sellerStockCreateKeysOnly(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    function sellerCreatesStockDeduction(allowedFields) {
      return sellerStockCreateKeysOnly(allowedFields)
        && request.resource.data.cantidadEnBase is number
        && request.resource.data.cantidadEnBase <= 0
        && (!request.resource.data.keys().hasAny(['cantidadDisponible'])
          || (request.resource.data.cantidadDisponible is number && request.resource.data.cantidadDisponible <= 0))
        && (!request.resource.data.keys().hasAny(['currentQty'])
          || (request.resource.data.currentQty is number && request.resource.data.currentQty <= 0));
    }

    function sellerUpdatesStockDownOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(stockFieldsOnly())
        && request.resource.data.cantidadEnBase is number
        && resource.data.cantidadEnBase is number
        && request.resource.data.cantidadEnBase <= resource.data.cantidadEnBase
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['cantidadDisponible'])
          || (request.resource.data.cantidadDisponible is number
            && ((resource.data.cantidadDisponible is number
                && request.resource.data.cantidadDisponible <= resource.data.cantidadDisponible)
              || (!resource.data.keys().hasAny(['cantidadDisponible'])
                && request.resource.data.cantidadDisponible <= 0))))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentQty'])
          || (request.resource.data.currentQty is number
            && ((resource.data.currentQty is number
                && request.resource.data.currentQty <= resource.data.currentQty)
              || (!resource.data.keys().hasAny(['currentQty'])
                && request.resource.data.currentQty <= 0))));
    }

    function openingAllocationItems() {
      return [
        'masa_crepa',
        'carlota_unidad',
        'tiramisu_unidad',
        'fresas_crema_unidad',
        'duraznos_crema_unidad'
      ];
    }

    function branchOpeningAllocationFields() {
      return [
        'id', 'insumoId', 'productId', 'sucursal', 'branchId',
        'cantidadEnBase', 'cantidadDisponible', 'currentQty',
        'ultimaActualizacion', 'lastUpdated', 'asignacionVirtual'
      ];
    }

    function sellerCreatesOpeningBranchAllocation(docId) {
      return request.resource.data.keys().hasAll(['insumoId', 'sucursal', 'cantidadEnBase'])
        && request.resource.data.keys().hasOnly(branchOpeningAllocationFields())
        && request.resource.data.insumoId in openingAllocationItems()
        && request.resource.data.sucursal is string
        && request.resource.data.cantidadEnBase is number
        && request.resource.data.cantidadEnBase >= 0
        && (!request.resource.data.keys().hasAny(['id']) || request.resource.data.id == docId)
        && (!request.resource.data.keys().hasAny(['cantidadDisponible'])
          || (request.resource.data.cantidadDisponible is number && request.resource.data.cantidadDisponible >= 0))
        && (!request.resource.data.keys().hasAny(['currentQty'])
          || (request.resource.data.currentQty is number && request.resource.data.currentQty >= 0))
        && (!request.resource.data.keys().hasAny(['asignacionVirtual'])
          || request.resource.data.asignacionVirtual is bool);
    }

    function sellerUpdatesOpeningBranchAllocation(docId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(branchOpeningAllocationFields())
        && request.resource.data.keys().hasAll(['insumoId', 'sucursal', 'cantidadEnBase'])
        && request.resource.data.insumoId in openingAllocationItems()
        && request.resource.data.sucursal is string
        && request.resource.data.cantidadEnBase is number
        && request.resource.data.cantidadEnBase >= 0
        && (!request.resource.data.keys().hasAny(['id']) || request.resource.data.id == docId)
        && (!request.resource.data.keys().hasAny(['cantidadDisponible'])
          || (request.resource.data.cantidadDisponible is number && request.resource.data.cantidadDisponible >= 0))
        && (!request.resource.data.keys().hasAny(['currentQty'])
          || (request.resource.data.currentQty is number && request.resource.data.currentQty >= 0))
        && (!request.resource.data.keys().hasAny(['asignacionVirtual'])
          || request.resource.data.asignacionVirtual is bool);
    }

    function sellerCreatesInventoryMovement() {
      return (
          request.resource.data.keys().hasAll(['id', 'branchId', 'type', 'productId', 'quantity', 'timestamp'])
          && request.resource.data.quantity is number
        )
        || (
          request.resource.data.keys().hasAll(['id', 'tipo', 'insumoId', 'cantidadEnBase', 'sucursal', 'usuarioId', 'fecha'])
          && request.resource.data.insumoId in openingAllocationItems()
          && request.resource.data.cantidadEnBase is number
          && request.resource.data.fecha is number
        );
    }

    function sucursalOperationalFields() {
      return [
        'abierta', 'turnoActivoId', 'ultimaApertura',
        'fondoCaja', 'hayHielo', 'hayChantilly', 'hayPopotes', 'hayBaseFresas'
      ];
    }

    function validSucursalOperationalConfig() {
      return request.resource.data.keys().hasAny(['abierta'])
        && request.resource.data.abierta is bool
        && (!request.resource.data.keys().hasAny(['turnoActivoId'])
          || request.resource.data.turnoActivoId is string)
        && (!request.resource.data.keys().hasAny(['ultimaApertura'])
          || request.resource.data.ultimaApertura is number)
        && (!request.resource.data.keys().hasAny(['fondoCaja'])
          || request.resource.data.fondoCaja is number)
        && (!request.resource.data.keys().hasAny(['hayHielo'])
          || request.resource.data.hayHielo is bool)
        && (!request.resource.data.keys().hasAny(['hayChantilly'])
          || request.resource.data.hayChantilly is bool)
        && (!request.resource.data.keys().hasAny(['hayPopotes'])
          || request.resource.data.hayPopotes is bool)
        && (!request.resource.data.keys().hasAny(['hayBaseFresas'])
          || request.resource.data.hayBaseFresas is bool);
    }

    function sellerCreatesSucursalOperationalConfig() {
      return request.resource.data.keys().hasOnly(sucursalOperationalFields())
        && validSucursalOperationalConfig();
    }

    function sellerUpdatesSucursalOperationalConfig() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(sucursalOperationalFields())
        && validSucursalOperationalConfig();
    }

    // ── Usuarios ─────────────────────────────────────────────
    match /v2_users/{uid} {
      allow read: if esAutenticado() && (request.auth.uid == uid || esAdmin());
      allow create: if esAutenticado() && request.auth.uid == uid
                    && request.resource.data.keys().hasAll(['uid', 'nombre', 'correo', 'rol'])
                    && request.resource.data.keys().hasOnly(['uid', 'nombre', 'correo', 'rol', 'activo', 'sucursalBase'])
                    && request.resource.data.rol == 'VENDEDOR'
                    && (!request.resource.data.keys().hasAny(['activo', 'sucursalBase']));
      allow update: if esAutenticado() && (
        (request.auth.uid == uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'uid', 'activo', 'sucursalBase']))
        || esAdmin()
      );
      allow delete: if esAdmin();
    }

    match /v2_pin_authorizations/{pinHash} {
      allow get: if esVendedor();
      allow list: if false;
      allow create, update: if esAdmin()
        && request.resource.data.keys().hasAll(['pinHash', 'userId', 'displayName', 'role', 'branchId', 'active', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['pinHash', 'userId', 'displayName', 'role', 'branchId', 'active', 'updatedAt'])
        && request.resource.data.pinHash == pinHash
        && request.resource.data.active is bool;
      allow delete: if esAdmin();
    }

    // ── Ventas y Operaciones de Caja ──────────────────────────────────────
    match /v2_ventas/{docId} {
      // Vendedores filtran por sucursal en query de la app; rules validan rol real
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'total', 'fecha', 'sucursal', 'atendio'])
        && request.resource.data.total is number
        && request.resource.data.fecha is number;
      allow update: if esAdmin();
      allow delete: if false;
    }

    // v2_transactions — Registro inmutable de ventas (nueva arquitectura)
    match /v2_transactions/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'branchId', 'userId', 'type', 'grandTotal', 'createdAt'])
        && request.resource.data.grandTotal is number
        && request.resource.data.createdAt is number;
      allow update, delete: if false;
    }

    // v2_transaction_items (subcolección de v2_transactions, append-only)
    match /v2_transactions/{docId}/v2_transaction_items/{itemId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['referenceId', 'productId', 'quantity', 'unit', 'unitPrice', 'subtotal', 'type'])
        && request.resource.data.quantity is number
        && request.resource.data.unit is string
        && request.resource.data.type in ['SALE', 'CANCELATION', 'ADJUSTMENT'];
      allow update, delete: if false;
    }

    match /v2_turnos_caja/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'sucursal', 'estado', 'fondoInicial'])
        && (
          request.resource.data.estado == 'abierto'
          || (
            request.resource.data.offlineContingency == true
            && request.resource.data.estado in ['abierto', 'cerrado']
            && request.resource.data.keys().hasOnly([
              'id', 'sucursal', 'usuarioId', 'usuarioNombre', 'rol',
              'fondoInicial', 'fechaApertura', 'fechaCierre', 'estado',
              'efectivoContado', 'tarjetaContada', 'offlineContingency',
              'syncTimestamp'
            ])
          )
        );
      allow update: if esVendedor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'estado', 'fechaCierre', 'efectivoContado', 'tarjetaContada',
          'diferenciaEfectivo', 'diferenciaTarjeta',
          'totalVentasEfectivo', 'totalVentasTarjeta', 'totalGastosTurno'
        ]);
      allow delete: if false;
    }

    match /v2_jornadas/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['empleadoId', 'empleadoNombre', 'dia', 'inicioReal', 'estado'])
        && request.resource.data.empleadoId == request.auth.uid
        && request.resource.data.inicioReal is number
        && request.resource.data.dia is number;
      allow update: if esAdmin() || (esVendedor()
        && resource.data.empleadoId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pausas', 'estado', 'finReal', 'horasEfectivas', 'notas'
        ]));
      allow delete: if false;
    }

    match /v2_registro_jornadas/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['usuario', 'sucursal', 'accion', 'rol', 'sesionId', 'timestamp'])
        && request.resource.data.sesionId == request.auth.uid
        && request.resource.data.timestamp is number
        && request.resource.data.accion in ['inicio_turno', 'unirse_turno', 'pausa', 'cierre_turno'];
      allow update, delete: if false;
    }

    match /v2_gastos/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'monto', 'fecha', 'sucursal'])
        && keysHaveAny(['concepto'], ['descripcion'])
        && request.resource.data.monto is number;
      allow update: if esAdmin();
      allow delete: if false;
    }

    // ── Catálogos y Configuración (Lectura Global, Escritura Admin) ─────────
    match /v2_products/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_recetas/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_supplies/{docId} {
      allow read: if esAutenticado();
      allow create, delete: if esAdmin();
      allow update: if esAdmin() || (esVendedor() && sellerUpdatesStockDownOnly());
    }
    match /v2_categorias/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_sucursales/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_configuracion/{docId} {
      allow read: if esAutenticado();
      allow create, update: if esAdmin() || (esVendedor()
        && docId.matches('contadores_.*')
        && request.resource.data.keys().hasOnly(['ultimo_ticket', 'sucursal', 'creado']));
      allow delete: if esAdmin();
    }
    match /v2_sucursal_config/{docId} {
      allow read: if esAutenticado();
      allow create: if esAdmin() || (esVendedor() && sellerCreatesSucursalOperationalConfig());
      allow update: if esAdmin() || (esVendedor() && sellerUpdatesSucursalOperationalConfig());
      allow delete: if esAdmin();
    }
    match /v2_units_catalog/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_discounts/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_recipes/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }

    // ── Inventario y Stock ───────────────────────────────────────────────
    match /v2_inventory_global/{docId} {
      allow read: if esVendedor();
      allow create: if esAdmin() || (esVendedor() && sellerCreatesStockDeduction(['id', 'insumoId', 'productId', 'cantidadEnBase', 'cantidadDisponible', 'currentQty', 'ultimaActualizacion', 'lastUpdated']));
      allow update: if esAdmin() || (esVendedor() && sellerUpdatesStockDownOnly());
      allow delete: if esAdmin();
    }

    match /v2_inventory_branch_portions/{docId} {
      allow read: if esVendedor();
      allow create: if esAdmin()
        || (esVendedor() && sellerCreatesStockDeduction(['id', 'insumoId', 'productId', 'sucursal', 'branchId', 'cantidadEnBase', 'cantidadDisponible', 'currentQty', 'ultimaActualizacion', 'lastUpdated']))
        || (esVendedor() && sellerCreatesOpeningBranchAllocation(docId));
      allow update: if esAdmin()
        || (esVendedor() && sellerUpdatesStockDownOnly())
        || (esVendedor() && sellerUpdatesOpeningBranchAllocation(docId));
      allow delete: if esAdmin();
    }

    match /v2_inventory_movements/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor() && sellerCreatesInventoryMovement();
      allow update, delete: if false;
    }

    // v2_movements — Traza de auditoría (nueva arquitectura, append-only)
    match /v2_movements/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'branchId', 'type', 'productId', 'quantity', 'timestamp', 'userId'])
        && request.resource.data.quantity is number
        && request.resource.data.timestamp is number;
      allow update, delete: if false;
    }

    // ── Auditoría y Logs (Vendedor Crea, Admin Lee) ──────────────────────
    match /v2_auditoria_cancelaciones/{docId} {
      allow read: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'productoNombre', 'precio', 'cantidad', 'motivo', 'usuario', 'sucursal', 'estado', 'fecha']);
      allow update: if esAdmin();
      allow delete: if esAdmin();
    }

    match /v2_merma_logs/{docId} {
      allow read: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['insumoId', 'cantidad', 'motivo', 'sucursal', 'fecha'])
        && request.resource.data.cantidad is number;
      allow update, delete: if false;
    }

    // ── Gestión de Clientes ─────────────────────────────────────────────
    match /v2_customers/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor() && request.resource.data.keys().hasAll(['nombre', 'telefono']);
      allow update: if esVendedor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'telefono', 'visitasCicloActual', 'comprasCicloActual', 'fechaUltimaVisita'
        ]);
      allow delete: if esAdmin();
    }

    // ── Operaciones Administrativas y Cierres ───────────────────────────
    match /v2_aperturas/{docId} {
      allow read: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['sucursal', 'fecha'])
        && keysHaveAny(['usuario'], ['usuarioId']);
      allow update, delete: if false;
    }

    match /v2_inventory_closures/{docId} {
      allow read: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['sucursal', 'fecha'])
        && keysHaveAny(['usuario'], ['usuarioId'])
        && keysHaveAny(['inventarioFinal'], ['sobrantes']);
      allow update, delete: if false;
    }

    match /v2_inventory_openings/{docId} {
      allow read: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['sucursal', 'fecha'])
        && keysHaveAny(['usuario'], ['usuarioId']);
      allow update, delete: if false;
    }

    match /v2_operaciones_generales/{docId} {
      allow read: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['tipo', 'descripcion', 'fecha'])
        && keysHaveAny(['usuario'], ['usuarioId']);
      allow update, delete: if false;
    }

    // ── Resto de colecciones administrativas ─────────────────────────────
    match /v2_purchase_history/{docId} { allow read, write: if esAdmin(); }
    match /v2_suppliers/{docId} { allow read, write: if esAdmin(); }
    match /v2_employees/{docId} {
      allow get: if esAdmin() || (esAutenticado() && resource.data.authUid == request.auth.uid);
      allow list: if esAdmin();
      allow write: if esAdmin();
    }
    match /v2_auditoria_empleados/{docId} {
      allow read, update, delete: if esAdmin();
      allow create: if esVendedor()
        && request.resource.data.keys().hasAll(['id', 'empleadoId', 'nombreEmpleado', 'accion', 'responsable', 'sucursal', 'fecha'])
        && request.resource.data.responsable == request.auth.uid;
    }
    match /v2_devoluciones/{docId} {
      allow read: if esVendedor();
      allow create: if esVendedor() && request.resource.data.estado == 'pendiente';
      allow update: if esAdmin();
      allow delete: if false;
    }

    // ── Colecciones Adicionales (Operación, Menú y Administración) ──────────
    match /promociones/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_presentaciones_compra/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_catalogo_opciones/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_recetas_produccion/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_proveedores/{docId} { allow read, write: if esAdmin(); }
    match /v2_combos/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_grupos_configuracion/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }
    match /v2_configuracion_salarial/{docId} { allow read: if esAutenticado(); allow write: if esAdmin(); }

    match /v2_pagos/{docId} {
      allow read, create: if esAdmin();
      allow update, delete: if false;
    }

    match /v2_transferencias_mesa/{docId} {
      allow read, create: if esVendedor();
      allow update, delete: if esAdmin();
    }

    match /v2_mesas/{docId} {
      allow read: if esAutenticado();
      allow create, update: if esVendedor();
      allow delete: if esAdmin();
    }

    match /v2_zonas/{docId} {
      allow read: if esAutenticado();
      allow write: if esAdmin();
    }

    match /v2_nominas/{docId} { allow read, write: if esAdmin(); }
    match /v2_incidencias/{docId} { allow read, write: if esAdmin(); }

    match /v2_turnos_personal/{docId} {
      allow read: if esAutenticado();
      allow create, update: if esVendedor();
      allow delete: if esAdmin();
    }

    match /v2_solicitudes/{docId} {
      allow read: if esAutenticado();
      allow create: if esAutenticado()
        && request.resource.data.keys().hasOnly(['empleadoId', 'tipo', 'fecha', 'motivo', 'sucursalId', 'estado'])
        && request.resource.data.empleadoId == request.auth.uid
        && request.resource.data.tipo in ['permiso', 'cambio', 'incapacidad']
        && request.resource.data.fecha is number;
      allow update, delete: if esAdmin();
    }

    // ── Denegar todo lo no especificado ─────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
