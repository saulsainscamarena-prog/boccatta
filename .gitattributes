* text=auto

# Source and configuration files stay LF across Windows agents.
*.gradle text eol=lf
*.kts text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.rules text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows entrypoints keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
